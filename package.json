{
  "name": "sadist",
  "version": "0.5.3",
  "description": "A sadistic TypeScript gate that holds your commit hostage until the code is no longer a liability.",
  "license": "MIT",
  "keywords": ["typescript", "eslint", "pre-commit", "code-quality", "strict", "gate", "lint"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElBenjaMasLindo/sadist.git"
  },
  "author": "ElBenjaMasLindo",
  "bugs": {
    "url": "https://github.com/ElBenjaMasLindo/sadist/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sadist": "./bin/sadist.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config/strict": "./dist/config/strict.js"
  },
  "files": ["dist", "bin", "docs/SKILL.md"],
  "scripts": {
    "prebuild": "node scripts/version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "peerDependencies": {
    "typescript": ">=5.4",
    "eslint": ">=9"
  },
  "dependencies": {
    "ts-pattern": "5.9.0",
    "@typescript-eslint/parser": "8.48.1",
    "@typescript-eslint/eslint-plugin": "8.48.1"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "vitest": "2.1.9",
    "typescript": "5.6.3",
    "eslint": "9.39.5",
    "@types/node": "24.13.3"
  }
}
